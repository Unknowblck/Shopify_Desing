          <span className="font-display text-[18px] font-medium text-ink">{q}</span>
          <span className={`grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line text-rose transition-transform duration-300 ${open ? 'rotate-45 bg-rose/10' : ''}`}><Icon name="plus" className="text-[16px]" /></span>
        </button>
        <div id={`faq-panel-${id}`} className={`faq-panel ${open ? 'open' : ''}`}><div><p className="px-6 pb-6 text-[15.5px] leading-relaxed text-ink/65">{a}</p></div></div>
      </div>
    );
  }

  function Faq() {
    const [open, setOpen] = useState(0);
    return (
      <Section id="faq" className="py-16 sm:py-24">
        <div className="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
