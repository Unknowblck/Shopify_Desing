            <p className="mt-5 text-[16px] leading-relaxed text-ink/60">¿Tienes otra duda? Escríbenos y te respondemos antes de reservar.</p>
          </Reveal>
          <Reveal delay={100}>
            <div className="flex flex-col gap-3">
              {FAQS.map(([q, a], i) => (
                <FaqItem key={i} id={i} q={q} a={a} open={open === i} onToggle={() => setOpen(open === i ? -1 : i)} />
              ))}
            </div>
          </Reveal>
        </div>
      </Section>
    );
  }

  /* ===================== FOOTER ===================== */
  function Footer() {
    return (
      <footer className="bg-ink px-5 pt-16 pb-10 text-cream/80 sm:px-8">
