<script src="https://unpkg.com/react@18.3.1/umd/react.development.js" crossorigin="anonymous"></script>
<script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js" crossorigin="anonymous"></script>
<script src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js" crossorigin="anonymous"></script>

<style>
  #msg-root, #msg-root * { box-sizing: border-box; }
  #msg-root { background: #F3EBE1 !important; color: #2B2019 !important; -webkit-font-smoothing: antialiased; font-family: 'Inter', system-ui, sans-serif; position: relative; isolation: isolate; overflow-x: hidden; }
  #msg-root .reveal { min-width: 0; }
  #msg-root img, #msg-root video { max-width: 100% !important; height: auto; display: block; }
  #msg-root ::selection { background: rgba(138,90,61,0.20); }

  #msg-root .font-display { font-family: 'Fraunces', Georgia, serif; font-optical-sizing: auto; }
  #msg-root .headline { letter-spacing: -0.018em; line-height: 1.04; }

  #msg-root .grad-cta {
    background-image: linear-gradient(100deg, #8C5E40 0%, #C2986B 50%, #8C5E40 100%);
    background-size: 220% 100%;
    background-position: 0% 50%;
    transition: background-position 0.8s ease, box-shadow 0.5s ease, transform 0.3s ease;
    box-shadow: 0 10px 30px -12px rgba(122,79,55,0.55);
    cursor: pointer;
  }
  #msg-root .grad-cta:hover { background-position: 100% 50%; box-shadow: 0 16px 40px -12px rgba(122,79,55,0.7); transform: translateY(-1px); }
  #msg-root .grad-cta:active { transform: translateY(0); }

  #msg-root .grad-text {
    background-image: linear-gradient(100deg, #8C5E40, #C2986B);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  @keyframes msgMarqueeUp { from { transform: translateY(0); } to { transform: translateY(-50%); } }
  /* DEFENSA v5: !important para que ningun CSS del tema Savor pause la animacion */
  #msg-root .marquee-track {
    animation: msgMarqueeUp 16s linear infinite !important;
    -webkit-animation: msgMarqueeUp 16s linear infinite !important;
    will-change: transform;
    position: absolute !important;
    inset-inline: 0;
    top: 0;
  }
  #msg-root .marquee-pause:hover .marquee-track { animation-play-state: paused !important; }

  @keyframes msgMarqueeLeft { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  #msg-root .row-track { animation: msgMarqueeLeft 46s linear infinite; }
  #msg-root .row-pause:hover .row-track { animation-play-state: paused; }
  #msg-root .row-mask {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 6%, #000 94%, transparent 100%);
            mask-image: linear-gradient(to right, transparent 0%, #000 6%, #000 94%, transparent 100%);
  }

  /* DEFENSA: reveal por defecto visible; solo se oculta cuando JS le pone reveal-armed */
  #msg-root .reveal { opacity: 1; }
  #msg-root .reveal-armed { opacity: 0; transform: translateY(34px) scale(0.985); filter: blur(12px); transition: opacity 1s cubic-bezier(.2,.7,.2,1), transform 1s cubic-bezier(.2,.7,.2,1), filter 1s cubic-bezier(.2,.7,.2,1); will-change: opacity, transform, filter; }
  #msg-root .reveal-armed.is-in { opacity: 1; transform: none; filter: blur(0); }

  @keyframes msgFloaty { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
  #msg-root .floaty { animation: msgFloaty 5s ease-in-out infinite; }

  @media (prefers-reduced-motion: reduce) {
    #msg-root .reveal-armed { opacity: 1 !important; transform: none !important; filter: none !important; }
    #msg-root .marquee-track, #msg-root .row-track, #msg-root .floaty { animation: none; }
  }

  #msg-root .glow { filter: blur(70px); border-radius: 9999px; opacity: 0.55; }

  /* DEFENSA: grids responsive con !important anti-override del tema */
  @media (max-width: 639px) {
    #msg-root .msg-grid-2, #msg-root .msg-grid-3, #msg-root .msg-grid-4, #msg-root .msg-hero { grid-template-columns: 1fr !important; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    #msg-root .msg-grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    #msg-root .msg-grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    #msg-root .msg-grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    #msg-root .msg-hero  { grid-template-columns: 1fr !important; }
  }
  @media (min-width: 1024px) {
    #msg-root .msg-grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    #msg-root .msg-grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; }
    #msg-root .msg-grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)) !important; }
    #msg-root .msg-hero  { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr) !important; }
  }

  #msg-root .faq-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.45s cubic-bezier(.2,.7,.2,1); }
  #msg-root .faq-panel.open { grid-template-rows: 1fr; }
  #msg-root .faq-panel > div { overflow: hidden; }

  #msg-root :focus-visible { outline: 2px solid #8A5A3D; outline-offset: 3px; border-radius: 6px; }

  html { scroll-behavior: smooth; }
</style>

<div id="msg-root"></div>

<script type="text/babel">
  const { useState, useEffect, useRef } = React;
  const A = window.MSG_ASSETS;
  const CHECKOUT_URL = window.MSG_CHECKOUT_URL || '/products/masterclass-soft-glam';

  function scrollToId(id) {
    const el = document.getElementById(id);
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  const goOffer = () => { window.location.href = CHECKOUT_URL; };

  function Icon({ name, className = '', stroke = 1.5 }) {
    const p = { fill: 'none', stroke: 'currentColor', strokeWidth: stroke, strokeLinecap: 'round', strokeLinejoin: 'round' };
    const paths = {
      arrow: <path d="M5 12h14M13 6l6 6-6 6" {...p} />,
      check: <path d="M5 12.5l4.2 4.2L19 7" {...p} />,
      spark: <path d="M12 3v4M12 17v4M3 12h4M17 12h4M6.3 6.3l2.5 2.5M15.2 15.2l2.5 2.5M17.7 6.3l-2.5 2.5M8.8 15.2l-2.5 2.5" {...p} />,
      wallet: <path d="M3 8.5A2.5 2.5 0 015.5 6H18a2 2 0 012 2v1H6a1 1 0 100 2h14v6a2 2 0 01-2 2H5.5A2.5 2.5 0 013 16.5v-8zM17 13.5h.01" {...p} />,
      mirror: <path d="M12 3a6 6 0 016 6c0 3.5-2.7 5.7-6 6.2C8.7 14.7 6 12.5 6 9a6 6 0 016-6zM12 15.2V21M9 21h6" {...p} />,
      face: <path d="M12 3a9 9 0 100 18 9 9 0 000-18zM9 10h.01M15 10h.01M8.8 14.5c1 1.1 2 1.6 3.2 1.6s2.2-.5 3.2-1.6" {...p} />,
      brush: <path d="M14.5 3.5l6 6L11 19l-4 1 1-4 6.5-12.5zM13 6l5 5" {...p} />,
      eye: <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12zM12 9.2a2.8 2.8 0 100 5.6 2.8 2.8 0 000-5.6z" {...p} />,
      drop: <path d="M12 3.5c3.2 3.6 5.5 6.4 5.5 9.4A5.5 5.5 0 016.5 13c0-3 2.3-5.8 5.5-9.5z" {...p} />,
      lips: <path d="M3.5 10c2-2 4-1.5 5.5-.4C10 8.4 11 8 12 8s2 .4 3 1.6C16.5 8.5 18.5 8 20.5 10c-1 .5-2 2-4 3.4S13.5 16 12 16s-2.5-1.2-4.5-2.6S4.5 10.5 3.5 10z" {...p} />,
      crown: <path d="M4 8l3.5 3L12 5l4.5 6L20 8l-1.5 9h-13L4 8zM6 20h12" {...p} />,
      pen: <path d="M14.5 4.5l5 5M4 20l1-4L16.5 4.5a2.1 2.1 0 013 3L8 19l-4 1z" {...p} />,
      play: <path d="M8 5.5v13l11-6.5-11-6.5z" fill="currentColor" stroke="none" />,
      sound: <path d="M5 9v6h3l5 4V5L8 9H5zM16 9.5a3.5 3.5 0 010 5M18.5 7a7 7 0 010 10" {...p} />,
      mute: <path d="M5 9v6h3l5 4V5L8 9H5zM16 9l5 6M21 9l-5 6" {...p} />,
      plus: <path d="M12 6v12M6 12h12" {...p} />,
      clock: <path d="M12 3a9 9 0 100 18 9 9 0 000-18zM12 7.5V12l3 2" {...p} />,
      heart: <path d="M12 20s-7-4.4-7-9.2A3.8 3.8 0 0112 7a3.8 3.8 0 017 3.8C19 15.6 12 20 12 20z" {...p} />,
      insta: <path d="M4 8a4 4 0 014-4h8a4 4 0 014 4v8a4 4 0 01-4 4H8a4 4 0 01-4-4V8zM12 8.5a3.5 3.5 0 100 7 3.5 3.5 0 000-7zM17 6.8h.01" {...p} />,
      tiktok: <path d="M14 4c.4 2.4 2 4 4.5 4.2V11C16.8 11 15.4 10.4 14 9.3V15a4.8 4.8 0 11-4.8-4.8c.3 0 .6 0 .8.1v2.8a2 2 0 101.4 1.9V4H14z" {...p} />,
      mail: <path d="M3.5 6.5h17v11h-17zM4 7l8 6 8-6" {...p} />,
      image: <path d="M4 5h16v14H4zM4 16l4.5-4.5 4 4L16 12l4 4M9 9.5a1.2 1.2 0 100 .01" {...p} />
    };
    return (
      <svg viewBox="0 0 24 24" className={className} width="1em" height="1em" aria-hidden="true">
        {paths[name] || null}
      </svg>
    );
  }

  function Star({ className }) {
    return (
      <svg viewBox="0 0 24 24" className={className} width="1em" height="1em" aria-hidden="true">
        <path d="M12 3.2l2.5 5.1 5.6.8-4.1 4 1 5.6L12 16.1 6.9 18.7l1-5.6-4.1-4 5.6-.8L12 3.2z" fill="currentColor" />
      </svg>
    );
  }

  function GradientButton({ children, onClick, size = 'md', className = '', as = 'button', ...rest }) {
    const sizes = { sm: 'text-[14.5px] px-5 py-2.5', md: 'text-[15.5px] px-7 py-3.5', lg: 'text-[17px] px-9 py-[18px]' };
    const cls = `grad-cta inline-flex items-center justify-center gap-2 rounded-full font-medium tracking-[0.01em] text-white ${sizes[size]} ${className}`;
    if (as === 'a') return <a className={cls} onClick={onClick} {...rest}>{children}</a>;
    return <button className={cls} onClick={onClick} {...rest}>{children}</button>;
  }

  function Reveal({ children, delay = 0, as: Tag = 'div', className = '', ...rest }) {
    const ref = useRef(null);
    useEffect(() => {
      const el = ref.current;
      if (!el) return;
      el.classList.add('reveal-armed');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { el.classList.add('is-in'); io.unobserve(el); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });
      io.observe(el);
      const fallback = setTimeout(() => { el.classList.add('is-in'); io.disconnect(); }, 1800);
      return () => { io.disconnect(); clearTimeout(fallback); };
    }, []);
    return <Tag ref={ref} className={`reveal ${className}`} style={{ transitionDelay: `${delay}ms` }} {...rest}>{children}</Tag>;
  }

  function Section({ id, className = '', children, container = true }) {
    return (
      <section id={id} className={`px-5 sm:px-8 ${className}`}>
        {container ? <div className="mx-auto w-full max-w-content">{children}</div> : children}
      </section>
    );
  }

  function Eyebrow({ children, className = '' }) {
    return (
      <div className={`inline-flex items-center ${className}`}>
        <span className="text-[11px] font-medium tracking-[0.3em] uppercase text-ink/45">{children}</span>
      </div>
    );
  }

  function Placeholder({ label = 'foto', ratio = '3 / 4', className = '', icon = 'image', rounded = 'rounded-[28px]' }) {
    return (
      <div className={`relative overflow-hidden ${rounded} border border-dashed border-rose/40 bg-white/40 ${className}`} style={{ aspectRatio: ratio }}>
        <div className="absolute inset-0 opacity-[0.5]" style={{ backgroundImage: 'repeating-linear-gradient(135deg, rgba(138,90,61,0.10) 0 1px, transparent 1px 11px)' }}></div>
        <div className="absolute inset-0 flex flex-col items-center justify-center gap-2 text-rose/70">
          <Icon name={icon} className="text-[26px]" />
          <span className="font-mono text-[11px] tracking-wide text-ink/45">{label}</span>
        </div>
      </div>
    );
  }

  function Figure({ src, alt = '', ratio = '3 / 4', className = '', placeholder = 'foto', icon = 'image', rounded = 'rounded-[28px]', overlay = null, objectPos = 'center' }) {
    const [ok, setOk] = useState(!!src);
    if (!src || !ok) return <Placeholder label={placeholder} ratio={ratio} className={className} icon={icon} rounded={rounded} />;
    return (
      <div className={`relative overflow-hidden ${rounded} ${className}`} style={{ aspectRatio: ratio }}>
        <img src={src} alt={alt} loading="lazy" onError={() => setOk(false)} className="h-full w-full object-cover" style={{ objectPosition: objectPos }} />
        {overlay}
      </div>
    );
  }

  /* ===================== NAVBAR ===================== */
  function Navbar() {
    const [solid, setSolid] = useState(false);
    useEffect(() => {
      const onScroll = () => setSolid(window.scrollY > 24);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      return () => window.removeEventListener('scroll', onScroll);
    }, []);
    const links = [['El método', 'metodo'], ['Sobre Alejandra', 'sobre'], ['Testimonios', 'testimonios'], ['Preguntas', 'faq']];
    return (
      <header className={`sticky top-0 z-50 transition-all duration-500 ${solid ? 'bg-cream/80 backdrop-blur-xl border-b border-line/70' : 'bg-transparent border-b border-transparent'}`}>
        <div className="mx-auto flex h-[68px] max-w-content items-center justify-between px-5 sm:px-8">
          <a href="#top" onClick={(e) => { e.preventDefault(); window.scrollTo({ top: 0, behavior: 'smooth' }); }} className="font-display text-[21px] font-medium tracking-tight text-ink">Alejandra Galeano</a>
          <nav className="hidden items-center gap-8 md:flex">
            {links.map(([label, id]) => (
              <button key={id} onClick={() => scrollToId(id)} className="text-[14.5px] text-ink/65 transition-colors hover:text-ink">{label}</button>
            ))}
          </nav>
          <GradientButton size="sm" onClick={goOffer} className="shadow-none sm:shadow">Reservar mi cupo</GradientButton>
        </div>
      </header>
    );
  }

  /* ===================== HERO ===================== */
  const HERO_MEDIA = [
    { type: 'video', src: A.ugc1,  poster: A.pUgc1,  label: 'clip soft glam' },
    { type: 'video', src: A.promo, poster: A.pPromo, label: 'clip clase' },
    { type: 'video', src: A.ugc2,  poster: A.pUgc2,  label: 'clip alumna' }
  ];

  function MarqueeClip({ item }) {
    const ref = useRef(null);
    useEffect(() => {
      const v = ref.current;
      if (!v) return;
      const tryPlay = () => v.play().catch(() => {});
      tryPlay();
      const onFirstTouch = () => { tryPlay(); document.removeEventListener('click', onFirstTouch); document.removeEventListener('touchstart', onFirstTouch); };
      document.addEventListener('click', onFirstTouch, { passive: true });
      document.addEventListener('touchstart', onFirstTouch, { passive: true });
      return () => { document.removeEventListener('click', onFirstTouch); document.removeEventListener('touchstart', onFirstTouch); };
    }, []);
    return (
      <div className="relative overflow-hidden rounded-[18px] bg-ink/10 ring-1 ring-line/70" style={{ aspectRatio: '9 / 16' }}>
        <video ref={ref} src={item.src} poster={item.poster} muted loop playsInline autoPlay preload="metadata" className="h-full w-full object-cover" aria-label={item.label} />
      </div>
    );
  }

  function VerticalMarquee() {
    const items = [...HERO_MEDIA, ...HERO_MEDIA];
    return (
      <div className="marquee-pause relative h-full overflow-hidden rounded-[26px] ring-1 ring-line/60">
        <div className="marquee-track absolute inset-x-0 top-0 flex flex-col gap-3.5">
          {items.map((it, i) => (<div key={i} className="shrink-0"><MarqueeClip item={it} /></div>))}
        </div>
      </div>
    );
  }

  const HERO_FACTS = [
    ['mirror', 'En vivo + grabación', 'la ves cuando quieras'],
    ['face',   'Pensada desde cero',  'sin experiencia previa'],
    ['drop',   'Para todos los tonos','adaptable a tu piel'],
    ['brush',  'Lista de productos',  'incluida en PDF']
  ];

  function Hero() {
    return (
      <Section id="top" className="relative pt-7 pb-12 sm:pt-10 sm:pb-16">
        <div className="pointer-events-none absolute -top-10 right-[8%] -z-10 h-72 w-72 glow" style={{ background: '#D8B58A' }}></div>
        <div className="pointer-events-none absolute top-40 -left-10 -z-10 h-72 w-72 glow" style={{ background: '#C9BBA7' }}></div>

        <div className="msg-hero grid grid-cols-1 items-center gap-9 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-10">
          <div className="order-2 flex min-w-0 flex-col justify-center lg:order-1">
            <Reveal>
              <div className="inline-flex items-center gap-2.5 rounded-full border border-line bg-white/70 px-4 py-2 backdrop-blur">
                <span className="flex items-center gap-0.5 text-rose"><Star className="text-[13px]" /><Star className="text-[13px]" /><Star className="text-[13px]" /><Star className="text-[13px]" /><Star className="text-[13px]" /></span>
                <span className="text-[13.5px] text-ink/70"><b className="font-semibold text-ink">4.9</b> · +10.000 alumnas ya aprendieron</span>
              </div>
            </Reveal>
            <Reveal delay={80}>
              <h1 className="font-display headline mt-5 text-[32px] font-normal text-ink sm:text-[40px] md:text-[42px] lg:text-[44px] xl:text-[52px]">
                Domina el <span className="grad-text italic">soft glam</span> y maquíllate como una profesional en un solo día.
              </h1>
            </Reveal>
            <Reveal delay={150}>
              <p className="mt-5 max-w-xl text-[16.5px] leading-relaxed text-ink/65">
                La técnica de maquillaje natural, luminoso y elegante que toda mujer quiere dominar. Paso a paso, en vivo, con Alejandra Galeano.
              </p>
            </Reveal>
            <Reveal delay={210}>
              <div className="mt-6 flex max-w-full flex-wrap items-center gap-x-2 gap-y-1 self-start rounded-2xl bg-ink/[0.04] px-4 py-2 text-[13.5px] text-ink/75">
                <span className="relative flex h-2 w-2 shrink-0">
                  <span className="absolute inline-flex h-full w-full animate-ping rounded-full bg-rose opacity-70"></span>
                  <span className="relative inline-flex h-2 w-2 rounded-full bg-rose"></span>
                </span>
                <span className="whitespace-nowrap">Clase en vivo</span>
                <span className="opacity-50">·</span>
                <b className="whitespace-nowrap font-semibold text-ink">sábado 21 de junio</b>
                <span className="opacity-50">·</span>
                <span className="whitespace-nowrap">cupos limitados</span>
              </div>
            </Reveal>
            <Reveal delay={270}>
              <div className="mt-7 flex flex-wrap items-center gap-4">
                <GradientButton size="lg" onClick={goOffer}>Quiero mi cupo <Icon name="arrow" className="text-[18px]" /></GradientButton>
                <button onClick={() => scrollToId('testimonios')} className="text-[15px] text-ink/60 underline-offset-4 transition-colors hover:text-ink hover:underline">Ver resultados de alumnas</button>
              </div>
            </Reveal>
