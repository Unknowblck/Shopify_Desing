<script>
  /* Asset URLs servidos por Shopify CDN (resueltos por Liquid) */
  window.MSG_ASSETS = {
    aleHero: {{ 'alejandra-hero.jpg'        | asset_url | json }},
    alePro:  {{ 'alejandra-pro.jpg'         | asset_url | json }},
    pUgc1:   {{ 'poster-ugc-1.jpg'          | asset_url | json }},
    pUgc2:   {{ 'poster-ugc-2.jpg'          | asset_url | json }},
    pPromo:  {{ 'poster-masterclass-promo.jpg' | asset_url | json }},
    ugc1:    {{ 'ugc-1.mp4'                 | asset_url | json }},
    ugc2:    {{ 'ugc-2.mp4'                 | asset_url | json }},
    promo:   {{ 'masterclass-promo.mp4'     | asset_url | json }}
  };
  /* URL del checkout / producto en Shopify — editable desde el theme editor (settings) */
  window.MSG_CHECKOUT_URL = {{ section.settings.checkout_url | default: '/products/masterclass-soft-glam' | json }};
</script>

