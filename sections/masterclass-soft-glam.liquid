            <div className="flex items-center gap-3">
              {[['insta', 'Instagram'], ['tiktok', 'TikTok'], ['mail', 'Correo']].map(([ic, l]) => (
                <a key={ic} href="#" aria-label={l} className="grid h-11 w-11 place-items-center rounded-full border border-white/15 text-cream/80 transition-colors hover:border-white/40 hover:text-cream"><Icon name={ic} className="text-[19px]" /></a>
              ))}
            </div>
          </div>
          <div className="flex flex-col gap-3 pt-7 text-[12.5px] text-cream/40 sm:flex-row sm:items-center sm:justify-between">
            <p>© {new Date().getFullYear()} Alejandra Galeano · Todos los derechos reservados.</p>
            <div className="flex flex-wrap items-center gap-x-5 gap-y-2">
              <a href="#" className="transition-colors hover:text-cream/70">Términos y condiciones</a>
              <a href="#" className="transition-colors hover:text-cream/70">Política de privacidad</a>
            </div>
          </div>
          <p className="mt-6 max-w-3xl text-[11.5px] leading-relaxed text-cream/30">Los resultados varían según la práctica y los productos de cada persona. Esta masterclass es de carácter formativo y no garantiza resultados específicos.</p>
        </div>
      </footer>
    );
  }

  /* ===================== APP ===================== */
  function App() {
    return (
      <>
        <Navbar />
        <main>
          <Hero />
          <Problema />
          <Agitacion />
          <Solucion />
          <Aprender />
          <SobreAlejandra />
          <Testimonios />
          <ResenasMarquee />
          <Oferta />
          <Faq />
        </main>
        <Footer />
      </>
    );
  }

  /* DEFENSA: espera a que Tailwind cargue antes de renderizar */
  function msgBoot() {
    if (typeof tailwind === 'undefined' || !document.styleSheets.length) {
      return setTimeout(msgBoot, 60);
    }
    ReactDOM.createRoot(document.getElementById('msg-root')).render(<App />);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', msgBoot);
  } else {
    msgBoot();
  }
</script>
