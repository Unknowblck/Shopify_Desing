  /* ===================== VIDEO PLAYER (UGC) ===================== */
  function VideoPlayer({ src, poster, label }) {
    const ref = useRef(null);
    const [muted, setMuted] = useState(true);
    const [hover, setHover] = useState(false);
    const [failed, setFailed] = useState(false);
    useEffect(() => {
      const v = ref.current;
      if (!v) return;
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting && e.intersectionRatio >= 0.5) v.play().catch(() => {}); else v.pause(); });
      }, { threshold: [0, 0.5, 1] });
      io.observe(v);
      return () => io.disconnect();
    }, []);
    if (failed) return <Placeholder label={label} ratio="9 / 16" icon="play" rounded="rounded-[26px]" />;
    const toggleSound = () => { const v = ref.current; if (!v) return; v.muted = !v.muted; if (!v.muted) v.play().catch(() => {}); setMuted(v.muted); };
    return (
      <div className="group relative overflow-hidden rounded-[26px] ring-1 ring-line/60 shadow-[0_24px_55px_-32px_rgba(28,22,20,0.5)]" style={{ aspectRatio: '9 / 16' }} onMouseEnter={() => setHover(true)} onMouseLeave={() => setHover(false)}>
        <video ref={ref} src={src} poster={poster} muted loop playsInline preload="metadata" onError={() => setFailed(true)} onClick={toggleSound} className="h-full w-full cursor-pointer object-cover" />
        <div className={`pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-ink/45 to-transparent transition-opacity duration-300 ${hover || !muted ? 'opacity-100' : 'opacity-60'}`}></div>
        <button onClick={toggleSound} aria-label={muted ? 'Activar sonido' : 'Silenciar'} className={`absolute bottom-3.5 right-3.5 grid h-10 w-10 place-items-center rounded-full bg-white/85 text-ink backdrop-blur transition-all duration-300 hover:bg-white ${hover || !muted ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-2'}`}>
          <Icon name={muted ? 'mute' : 'sound'} className="text-[18px]" />
        </button>
        <div className={`absolute left-3.5 top-3.5 rounded-full bg-white/80 px-3 py-1 text-[11px] font-medium text-ink/70 backdrop-blur transition-opacity duration-300 ${muted ? 'opacity-100' : 'opacity-0'}`}>toca para escuchar</div>
      </div>
    );
  }

